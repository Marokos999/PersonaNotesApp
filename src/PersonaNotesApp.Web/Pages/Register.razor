@page "/register"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Registracija — PersonaNotes</PageTitle>

<div class="auth-card">
    <div class="auth-card-header">
        <h2 class="auth-title">Kreiraj nalog</h2>
        <p class="auth-subtitle">Počni da koristiš PersonaNotes</p>
    </div>

    @if (errorMessage is not null)
    {
        <div class="auth-error">@errorMessage</div>
    }

    @if (success)
    {
        <div class="auth-success">
            Nalog kreiran! <a href="/login">Prijavi se</a>
        </div>
    }
    else
    {
        <div class="auth-form">
            <div class="auth-field">
                <label class="auth-label">Email adresa</label>
                <input class="form-control" placeholder="you@example.com" @bind="email" type="email" />
            </div>
            <div class="auth-field">
                <label class="auth-label">Lozinka</label>
                <input class="form-control" placeholder="Minimum 6 znakova" @bind="password" type="password"
                       @onkeydown="OnKeyDown" />
            </div>
            <button class="btn btn-primary auth-submit" @onclick="DoRegister" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="auth-spinner"></span>
                }
                Registruj se
            </button>
        </div>

        <p class="auth-footer">
            Imaš nalog? <a href="/login">Prijavi se</a>
        </p>
    }
</div>

@code {
    private string email = "";
    private string password = "";
    private string? errorMessage;
    private bool isLoading;
    private bool success;

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await DoRegister();
    }

    private async Task DoRegister()
    {
        errorMessage = null;
        isLoading = true;

        var response = await Http.PostAsJsonAsync("/api/auth/register",
            new { Email = email, Password = password });

        if (!response.IsSuccessStatusCode)
        {
            errorMessage = "Registracija neuspješna. Lozinka mora imati min. 6 znakova, jedno veliko slovo i jedan broj.";
            isLoading = false;
            return;
        }

        success = true;
        isLoading = false;
    }
}
