@page "/register"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Registracija — PersonaNotes</PageTitle>

<div class="auth-card">
    <div class="auth-card-header">
        <h2 class="auth-title">Kreiraj nalog</h2>
        <p class="auth-subtitle">Počni da koristiš PersonaNotes</p>
    </div>

    @if (errorMessage is not null)
    {
        <div class="auth-error">@errorMessage</div>
    }

    @if (success)
    {
        <div class="auth-success">
            Nalog kreiran! <a href="/login">Prijavi se</a>
        </div>
    }
    else
    {
        <div class="auth-form">
            <div class="auth-field">
                <label class="auth-label">Email adresa</label>
                <input class="form-control" placeholder="you@example.com" @bind="email" @bind:event="oninput" type="email" />
            </div>
            <div class="auth-field">
                <label class="auth-label">Lozinka</label>
                <input class="form-control" placeholder="Minimum 8 znakova" @bind="password" @bind:event="oninput" type="password"
                       @onkeydown="OnKeyDown" />
            </div>
            <button class="btn btn-primary auth-submit" @onclick="DoRegister" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="auth-spinner"></span>
                }
                Registruj se
            </button>
            <p class="auth-legal">
                Registracijom prihvataš
                <a href="/terms" target="_blank" rel="noopener">Terms of Service</a> i
                <a href="/privacy" target="_blank" rel="noopener">Privacy Policy</a>.
            </p>
        </div>

        <p class="auth-footer">
            Imaš nalog? <a href="/login">Prijavi se</a>
        </p>
    }
</div>

@code {
    private string email = "";
    private string password = "";
    private string? errorMessage;
    private bool isLoading;
    private bool success;

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await DoRegister();
    }

    private async Task DoRegister()
    {
        errorMessage = null;
        isLoading = true;

        var response = await Http.PostAsJsonAsync("/api/auth/register",
            new { Email = email, Password = password });

        if (!response.IsSuccessStatusCode)
        {
            errorMessage = response.StatusCode switch
            {
                System.Net.HttpStatusCode.Conflict => "Email je već registrovan.",
                System.Net.HttpStatusCode.TooManyRequests => "Previše pokušaja. Pokušaj ponovo za minut.",
                _ => await ReadValidationErrorsAsync(response)
            };
            isLoading = false;
            return;
        }

        success = true;
        isLoading = false;
    }

    private static async Task<string> ReadValidationErrorsAsync(HttpResponseMessage response)
    {
        const string fallback = "Registracija neuspješna. Lozinka mora imati min. 8 znakova, malo i veliko slovo, broj i poseban znak.";
        try
        {
            using var doc = await System.Text.Json.JsonDocument.ParseAsync(await response.Content.ReadAsStreamAsync());
            if (!doc.RootElement.TryGetProperty("errors", out var errors)) return fallback;

            var messages = errors.EnumerateObject()
                .SelectMany(p => p.Value.EnumerateArray().Select(m => m.GetString()))
                .Where(m => !string.IsNullOrEmpty(m));
            var joined = string.Join(" ", messages);
            return joined.Length > 0 ? joined : fallback;
        }
        catch
        {
            return fallback;
        }
    }
}
