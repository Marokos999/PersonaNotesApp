@page "/login"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject HttpClient Http
@inject JwtAuthProvider Auth
@inject NavigationManager Nav

<PageTitle>Login — PersonaNotes</PageTitle>

<div class="auth-card">
    <div class="auth-card-header">
        <h2 class="auth-title">Dobrodošao nazad</h2>
        <p class="auth-subtitle">Prijavi se na svoj nalog</p>
    </div>

    @if (errorMessage is not null)
    {
        <div class="auth-error">@errorMessage</div>
    }

    <div class="auth-form">
        <div class="auth-field">
            <label class="auth-label">Email adresa</label>
            <input class="form-control" placeholder="you@example.com" @bind="email" @bind:event="oninput" type="email" />
        </div>
        <div class="auth-field">
            <label class="auth-label">Lozinka</label>
            <input class="form-control" placeholder="••••••••" @bind="password" @bind:event="oninput" type="password"
                   @onkeydown="OnKeyDown" />
        </div>
        <button class="btn btn-primary auth-submit" @onclick="DoLogin" disabled="@isLoading">
            @if (isLoading)
            {
                <span class="auth-spinner"></span>
            }
            Prijavi se
        </button>
    </div>

    <p class="auth-footer">
        Nemaš nalog? <a href="/register">Registruj se</a>
    </p>
</div>

@code {
    private string email = "";
    private string password = "";
    private string? errorMessage;
    private bool isLoading;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await DoLogin();
    }

    private async Task DoLogin()
    {
        errorMessage = null;
        isLoading = true;

        var response = await Http.PostAsJsonAsync("/api/auth/login",
            new { Email = email, Password = password });

        if (!response.IsSuccessStatusCode)
        {
            errorMessage = "Pogrešan email ili lozinka.";
            isLoading = false;
            return;
        }

        var result = await response.Content.ReadFromJsonAsync<AuthResponse>();
        await Auth.NotifyLoginAsync(result!.AccessToken, result.RefreshToken);

        var target = !string.IsNullOrEmpty(ReturnUrl) ? Uri.UnescapeDataString(ReturnUrl) : "/notes";
        Nav.NavigateTo(target);
    }
}
