@inherits LayoutComponentBase

@* For pages that must be readable by everyone, signed in or not (privacy policy, terms). *@
<div class="legal-shell">
    <header class="legal-header">
        <a class="legal-brand" href="/">
            <span class="auth-brand-icon">📝</span>
            <span class="auth-brand-name">PersonaNotes</span>
        </a>
        <a class="btn btn-outline-secondary btn-sm" href="/">Open the app</a>
    </header>
    <main class="legal-main">
        <article class="legal-card">
            @Body
        </article>
    </main>
    <LegalLinks />
</div>
