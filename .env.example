# Copy to .env (never commit it) and replace the values.
POSTGRES_PASSWORD=change-me
# At least 32 characters, e.g. generate with: openssl rand -base64 48
JWT_SECRET=

# docker-compose.prod.yml (server): POSTGRES_PASSWORD goes into a connection string, so use letters and digits only
# (e.g. openssl rand -hex 24). Use `openssl rand -hex 32` for JWT_SECRET there as well.

# Public address of the site, used in robots.txt and the sitemap (e.g. https://notes.example.com)
APP_PUBLIC_URL=
# Shown on the privacy policy and terms pages. Fill both in before offering the app to other people.
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
